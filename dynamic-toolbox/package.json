{
  "name": "dsh-dynamic-toolbox",
  "version": "0.1.1",
  "description": "动态工具箱（DSH 原生静态工具箱）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./remote": "./lib/remote.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Iwctwbh/dsh-flowglass.git",
    "directory": "dynamic-toolbox"
  },
  "license": "MIT",
  "author": "Iwctwbh",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "toolbox",
    "dynamic-toolbox"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib/**",
    "manifest.json",
    "BUILDINFO.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8",
    "react": "^18.3.1"
  }
}
